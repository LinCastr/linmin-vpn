msgid "Allow"
msgstr "Permitir"

msgid "Allow it once and the VPN will only configure its own network interface, without asking again."
msgstr "Permita uma vez e a VPN passa a configurar só a própria interface de rede, sem perguntar de novo."

msgid "Allow without password"
msgstr "Permitir sem senha"

msgid "APPEARANCE"
msgstr "APARÊNCIA"

msgid "Asks for the administrator password on each start."
msgstr "Pede a senha de administrador a cada vez que liga."

msgid "Back"
msgstr "Voltar"

msgid "Colors"
msgstr "Cores"

msgid "Connected"
msgstr "Conectada"

